# --- Identificacao ---
CONTAINER_NAME=cpanel-server
HOSTNAME=srv.seudominio.com.br
# Troque esta senha! Nunca use a padrao em producao.
ROOT_PASSWORD=TROQUE_ESTA_SENHA

# --- Rede e acesso ---
SSH_PORT_HOST=22028
SSH_PORT_CONTAINER=22
# login root por senha via SSH: no em producao, yes somente em lab
SSH_ROOT_LOGIN=no
CPANEL_SSL_PORT=2083
CPANEL_NON_SSL_PORT=2082
WHM_SSL_PORT=2087
WHM_NON_SSL_PORT=2086
HTTP_PORT_HOST=8091
HTTPS_PORT_HOST=8447
HTTP_PORT_CONTAINER=80
HTTPS_PORT_CONTAINER=443

# --- Recursos ---
CPU_LIMIT=2.0
MEM_LIMIT=4G
MEM_RESERVATION=2G

# --- Sistema ---
TIMEZONE=America/Sao_Paulo
LANG=C.utf8
